<ui:FluentWindow x:Class="TurboDL.App.Views.DetailsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:TurboDL.App.ViewModels"
                 xmlns:controls="clr-namespace:TurboDL.App.Controls"
                 xmlns:model="clr-namespace:TurboDL.Core.Model;assembly=TurboDL.Core"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance vm:DetailsViewModel}"
                 Title="{Binding Item.Name}"
                 Width="760" Height="680" MinWidth="560" MinHeight="480"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 FontFamily="{StaticResource TextFont}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Download details" ShowMinimize="False" ShowMaximize="False" />

        <!-- Header: what it is and how it's going. -->
        <StackPanel Grid.Row="1" Margin="24,0,24,16">
            <TextBlock Text="{Binding Item.Name}" Style="{StaticResource SubtitleText}" ToolTip="{Binding Item.Name}" />
            <TextBlock Text="{Binding Item.Info.Url}" Style="{StaticResource CaptionText}" Margin="0,4,0,0"
                       ToolTip="{Binding Item.Info.Url}" />

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Status" Style="{StaticResource CaptionText}" />
                    <TextBlock x:Name="StatusValue" Text="{Binding Item.StatusText}" Style="{StaticResource BodyText}" Margin="0,2,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Downloaded" Style="{StaticResource CaptionText}" />
                    <TextBlock Text="{Binding DownloadedText}" Style="{StaticResource BodyText}" Margin="0,2,0,0"
                               Typography.NumeralAlignment="Tabular" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Speed" Style="{StaticResource CaptionText}" />
                    <TextBlock Text="{Binding Item.SpeedText}" Style="{StaticResource BodyText}" Margin="0,2,0,0"
                               Typography.NumeralAlignment="Tabular" />
                </StackPanel>
                <StackPanel Grid.Column="3">
                    <TextBlock Text="Time left" Style="{StaticResource CaptionText}" />
                    <TextBlock Text="{Binding Item.RemainingText}" Style="{StaticResource BodyText}" Margin="0,2,0,0"
                               Typography.NumeralAlignment="Tabular" />
                </StackPanel>
            </Grid>
            <TextBlock Text="{Binding Item.Error}" Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,12,0,0"
                       Foreground="{DynamicResource SystemFillColorCriticalBrush}">
                <TextBlock.Visibility>
                    <Binding Path="Item.Status" Converter="{StaticResource EqualsToVisibility}"
                             ConverterParameter="{x:Static model:DownloadStatus.Failed}" />
                </TextBlock.Visibility>
            </TextBlock>
        </StackPanel>

        <Border Grid.Row="2" Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,1">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,16,24,16">
                <StackPanel>
                    <!-- The map: each block is a slice of the file. -->
                    <controls:SegmentMap Height="112" Segments="{Binding Item.Segments}" Total="{Binding Item.Total}"
                                         IsActive="{Binding Item.IsRunning}"
                                         Fill="{DynamicResource AccentFillColorDefaultBrush}"
                                         Head="{DynamicResource TextFillColorPrimaryBrush}"
                                         Empty="{DynamicResource DividerStrokeColorDefaultBrush}"
                                         AutomationProperties.Name="Map of downloaded parts" />
                    <DockPanel Margin="0,8,0,20">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding ConnectionsText}" Style="{StaticResource CaptionText}" />
                        <TextBlock Text="Each block is a slice of the file. Highlighted blocks are being written right now."
                                   Style="{StaticResource CaptionText}" />
                    </DockPanel>

                    <TextBlock Text="Connections" Style="{StaticResource BodyText}" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <ItemsControl ItemsSource="{Binding Parts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:SegmentRowViewModel">
                                <Grid Height="30">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36" />
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="52" />
                                        <ColumnDefinition Width="96" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Number}" Style="{StaticResource NumberText}" TextAlignment="Left"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                    <TextBlock Grid.Column="1" Text="{Binding RangeText}" Style="{StaticResource NumberText}"
                                               TextAlignment="Left" />
                                    <controls:SegmentBar x:Name="Bar" Grid.Column="2" Height="6" VerticalAlignment="Center"
                                                         Margin="0,0,12,0" Fraction="{Binding Fraction}"
                                                         Fill="{DynamicResource TextFillColorTertiaryBrush}"
                                                         Track="{DynamicResource DividerStrokeColorDefaultBrush}" />
                                    <TextBlock Grid.Column="3" Text="{Binding PercentText}" Style="{StaticResource NumberText}" />
                                    <TextBlock Grid.Column="4" Text="{Binding SpeedText}" Style="{StaticResource NumberText}" />
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsMoving}" Value="True">
                                        <Setter TargetName="Bar" Property="Fill" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Speed limit for this download" Style="{StaticResource BodyText}" FontWeight="SemiBold"
                               Margin="0,24,0,8" />
                    <StackPanel Orientation="Horizontal">
                        <ui:ToggleSwitch IsChecked="{Binding LimitEnabled}" OffContent="Off" OnContent="On" />
                        <ui:NumberBox Value="{Binding LimitKBps, UpdateSourceTrigger=PropertyChanged}" Minimum="1" Maximum="10000000"
                                      SmallChange="128" LargeChange="1024" MaxDecimalPlaces="0" Width="150" Margin="16,0,0,0"
                                      ClearButtonEnabled="False" IsEnabled="{Binding LimitEnabled}"
                                      AutomationProperties.Name="Speed limit in KB per second" />
                        <TextBlock Text="KB/s" Style="{StaticResource BodyText}" Margin="8,0,0,0" />
                    </StackPanel>

                    <TextBlock Text="Resumable" Style="{StaticResource BodyText}" FontWeight="SemiBold" Margin="0,24,0,4" />
                    <TextBlock Text="{Binding ResumeText}" Style="{StaticResource BodyText}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                    <TextBlock Text="Saved to" Style="{StaticResource BodyText}" FontWeight="SemiBold" Margin="0,16,0,4" />
                    <TextBlock Text="{Binding Item.Info.FilePath}" Style="{StaticResource BodyText}" TextWrapping="Wrap"
                               TextTrimming="None" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                    <TextBlock Text="Activity" Style="{StaticResource BodyText}" FontWeight="SemiBold" Margin="0,16,0,4" />
                    <TextBlock Text="Retries and connection changes show up here." Style="{StaticResource CaptionText}"
                               Visibility="{Binding Item.Log.Count, Converter={StaticResource ZeroToVisible}}" />
                    <ItemsControl ItemsSource="{Binding Item.Log}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                                           TextTrimming="None" Margin="0,1" Typography.NumeralAlignment="Tabular" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <DockPanel Grid.Row="3" Margin="24,16" LastChildFill="False">
            <ui:Button DockPanel.Dock="Left" Command="{Binding OpenFolderCommand}" Content="Show in folder" />
            <ui:Button DockPanel.Dock="Right" Content="Close" IsCancel="True" Click="OnClose" Margin="8,0,0,0" MinWidth="88" />
            <ui:Button x:Name="PauseResume" DockPanel.Dock="Right" Appearance="Primary" Command="{Binding PauseOrResumeCommand}"
                       MinWidth="104" />
        </DockPanel>
    </Grid>
</ui:FluentWindow>
