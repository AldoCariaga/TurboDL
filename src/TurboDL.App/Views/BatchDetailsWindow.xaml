<ui:FluentWindow x:Class="TurboDL.App.Views.BatchDetailsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:TurboDL.App.ViewModels"
                 xmlns:controls="clr-namespace:TurboDL.App.Controls"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance vm:BatchViewModel}"
                 Title="{Binding Name}"
                 Width="760" Height="680" MinWidth="520" MinHeight="480"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 FontFamily="{StaticResource TextFont}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Batch details" ShowMinimize="False" ShowMaximize="False" />

        <!-- Header: which batch, where, and how it's going. -->
        <StackPanel Grid.Row="1" Margin="24,0,24,16">
            <!-- Selectable, so the name, folder and status can be copied. -->
            <TextBox Text="{Binding Name, Mode=OneWay}" Style="{StaticResource SelectableSubtitle}"
                     AutomationProperties.Name="Batch name" />
            <TextBox Text="{Binding Info.Directory, Mode=OneWay}" Style="{StaticResource SelectableCaption}" Margin="0,4,0,0"
                     AutomationProperties.Name="Folder" />

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                    <TextBlock Text="Status" Style="{StaticResource CaptionText}" />
                    <TextBox Text="{Binding StatusText, Mode=OneWay}" Style="{StaticResource SelectableText}" Margin="0,2,0,0"
                             AutomationProperties.Name="Status" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Parts downloaded" Style="{StaticResource CaptionText}" />
                    <TextBlock Text="{Binding PartsText}" Style="{StaticResource BodyText}" Margin="0,2,0,0"
                               Typography.NumeralAlignment="Tabular" />
                </StackPanel>
            </Grid>

            <!-- Where it extracts and whether the parts go afterwards; changeable until extracting starts. -->
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                    <TextBlock Text="Extract to" Style="{StaticResource CaptionText}" />
                    <TextBox Text="{Binding ExtractToText, Mode=OneWay}" Style="{StaticResource SelectableText}" Margin="0,2,0,0"
                             AutomationProperties.Name="Extract to" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <ui:Button x:Name="ChangeExtractTo" Content="Change…" Click="OnChangeExtractTo"
                               ToolTip="Choose the folder the archives extract into (another drive works)" />
                    <ui:Button x:Name="DefaultExtractTo" Content="Default" Click="OnDefaultExtractTo" Margin="8,0,0,0"
                               ToolTip="Extract into a folder named Extracted next to the parts" />
                </StackPanel>
            </Grid>
            <ui:ToggleSwitch x:Name="DeletePartsSwitch" IsChecked="{Binding DeleteParts, Mode=OneWay}" Margin="0,12,0,0"
                             Click="OnDeletePartsClick"
                             Content="Delete the parts after extracting (permanently, frees the space)"
                             AutomationProperties.Name="Delete the parts permanently after extracting" />

            <!-- Extracting: 7-Zip's progress through the current archive; the status above says which one of how many. -->
            <Grid Margin="0,16,0,0" Visibility="{Binding HasProgress, Converter={StaticResource BoolToVisibility}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="52" />
                </Grid.ColumnDefinitions>
                <controls:SegmentBar Height="8" VerticalAlignment="Center" Fraction="{Binding ProgressFraction}"
                                     Fill="{DynamicResource AccentFillColorDefaultBrush}"
                                     Track="{DynamicResource DividerStrokeColorDefaultBrush}"
                                     AutomationProperties.Name="Extraction progress of the current archive" />
                <TextBlock Grid.Column="1" Text="{Binding ProgressText}" Style="{StaticResource NumberText}" />
            </Grid>
        </StackPanel>

        <Border Grid.Row="2" Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,1">
            <DockPanel Margin="24,16,24,16">
                <TextBlock DockPanel.Dock="Top" Text="Activity" Style="{StaticResource BodyText}" FontWeight="SemiBold"
                           Margin="0,0,0,4" />
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,0,0,8"
                           Text="Extraction, retries and parts solved in the browser show up here while TurboDL runs."
                           Visibility="{Binding Log.Count, Converter={StaticResource ZeroToVisible}}" />
                <!-- One selectable block: drag across lines, Ctrl+A, Ctrl+C. Follows new lines unless scrolled up. -->
                <controls:SelectableLog Lines="{Binding Log}" Style="{StaticResource SelectableLogText}"
                                        AutomationProperties.Name="Batch activity" />
            </DockPanel>
        </Border>

        <DockPanel Grid.Row="3" Margin="24,16" LastChildFill="False">
            <ui:Button DockPanel.Dock="Left" Content="Open folder" Click="OnOpenFolder" />
            <ui:Button x:Name="AddLinks" DockPanel.Dock="Left" Content="Add links…" Click="OnAddLinks" Margin="8,0,0,0"
                       ToolTip="Add links to this batch while it's still downloading: a missing part, or ones left out" />
            <ui:Button DockPanel.Dock="Right" Content="Close" IsCancel="True" Click="OnClose" MinWidth="88" />
        </DockPanel>
    </Grid>
</ui:FluentWindow>
