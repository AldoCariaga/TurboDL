<ui:FluentWindow x:Class="TurboDL.App.Views.CountdownWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Queue finished"
                 Width="420" SizeToContent="Height" ResizeMode="NoResize" MinWidth="0" MinHeight="0"
                 Topmost="True" WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 FontFamily="{StaticResource TextFont}">
    <StackPanel>
        <ui:TitleBar Title="TurboDL" ShowMinimize="False" ShowMaximize="False" />
        <StackPanel Margin="24,4,24,24">
            <TextBlock Text="All queued downloads are done" Style="{StaticResource SubtitleText}" TextWrapping="Wrap"
                       TextTrimming="None" />
            <TextBlock x:Name="Message" Style="{StaticResource BodyText}" Margin="0,8,0,0" TextWrapping="Wrap"
                       TextTrimming="None" Typography.NumeralAlignment="Tabular" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <ui:Button x:Name="NowButton" Content="Now" MinWidth="88" Click="OnNow" />
                <ui:Button Appearance="Primary" Content="Cancel" MinWidth="104" Margin="8,0,0,0" Click="OnCancel"
                           IsDefault="True" IsCancel="True" />
            </StackPanel>
        </StackPanel>
    </StackPanel>
</ui:FluentWindow>
