<ui:FluentWindow x:Class="TurboDL.App.Views.AddDownloadWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:TurboDL.App.ViewModels"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance vm:AddDownloadViewModel}"
                 Title="Add download"
                 Width="580" SizeToContent="Height" ResizeMode="NoResize"
                 ShowInTaskbar="False"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 FontFamily="{StaticResource TextFont}">

    <StackPanel>
        <ui:TitleBar Title="Add download" ShowMinimize="False" ShowMaximize="False" />

        <StackPanel Margin="24,4,24,20">
            <TextBlock Text="Link" Style="{StaticResource FieldLabel}" />
            <ui:TextBox x:Name="UrlBox" Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="https://example.com/file.zip" ClearButtonEnabled="True"
                        AutomationProperties.Name="Link" />

            <!-- Fixed height so the form doesn't jump while the link is being checked. -->
            <!-- At least one line high so the form doesn't jump; yt-dlp's messages may need more. -->
            <DockPanel MinHeight="32" Margin="0,4,0,8">
                <ui:ProgressRing DockPanel.Dock="Left" Width="14" Height="14" IsIndeterminate="True" Margin="0,0,8,0"
                                 Visibility="{Binding IsChecking, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock x:Name="NoteText" Text="{Binding Note}" Style="{StaticResource CaptionText}"
                           TextWrapping="Wrap" TextTrimming="None" VerticalAlignment="Top" Margin="0,2,0,0" />
            </DockPanel>

            <!-- First use of video support: yt-dlp, ffmpeg and Deno download on their own, with Cancel. -->
            <Border Visibility="{Binding IsSettingUpTools, Converter={StaticResource BoolToVisibility}}"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6"
                    Padding="16,12" Margin="0,0,0,16">
                <DockPanel>
                    <ui:Button DockPanel.Dock="Right" Content="Cancel" Command="{Binding CancelToolsCommand}"
                               VerticalAlignment="Center" Margin="16,0,0,0" />
                    <StackPanel>
                        <TextBlock Text="{Binding ToolsText}" Style="{StaticResource BodyText}" TextWrapping="Wrap"
                                   TextTrimming="None" Typography.NumeralAlignment="Tabular" />
                        <ProgressBar Margin="0,10,0,0" Height="4" Minimum="0" Maximum="1" Value="{Binding ToolsFraction, Mode=OneWay}"
                                     IsIndeterminate="{Binding ToolsIndeterminate}"
                                     AutomationProperties.Name="Video support setup progress" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Video mode: what yt-dlp found. -->
            <Grid Visibility="{Binding IsVideoMode, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="160" Height="90" CornerRadius="6" ClipToBounds="True"
                        Background="{DynamicResource ControlFillColorSecondaryBrush}" Margin="0,0,16,0">
                    <Image Source="{Binding Thumbnail, TargetNullValue={x:Null}, FallbackValue={x:Null}}" Stretch="UniformToFill"
                           RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="Video thumbnail" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding VideoTitle}" Style="{StaticResource BodyText}" FontWeight="SemiBold"
                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="40" ToolTip="{Binding VideoTitle}" />
                    <TextBlock Text="{Binding VideoMeta}" Style="{StaticResource CaptionText}" Margin="0,4,0,0" />
                </StackPanel>
            </Grid>

            <TextBlock Text="File name" Style="{StaticResource FieldLabel}" />
            <ui:TextBox Text="{Binding FileName, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="Taken from the server" AutomationProperties.Name="File name" />

            <StackPanel Visibility="{Binding IsVideoMode, Converter={StaticResource BoolToVisibility}}">
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Quality" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding Qualities}" SelectedItem="{Binding SelectedQuality}"
                                  AutomationProperties.Name="Quality" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" Width="120"
                                Visibility="{Binding ShowContainer, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Container" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding Containers}" SelectedItem="{Binding SelectedContainer}"
                                  AutomationProperties.Name="Container" />
                    </StackPanel>
                </Grid>
                <ListBox ItemsSource="{Binding Formats}" SelectedItem="{Binding SelectedFormat}" Height="168" Margin="0,8,0,0"
                         Visibility="{Binding ShowFormats, Converter={StaticResource BoolToVisibility}}"
                         Typography.NumeralAlignment="Tabular" AutomationProperties.Name="Formats" />
            </StackPanel>

            <TextBlock Text="Save to" Style="{StaticResource FieldLabel}" Margin="0,16,0,6" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBox Text="{Binding Folder, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Save to" />
                <ui:Button Grid.Column="1" Margin="8,0,0,0" Command="{Binding BrowseCommand}" Content="Browse"
                           VerticalAlignment="Stretch" />
            </Grid>

            <StackPanel Visibility="{Binding IsVideoMode, Converter={StaticResource InverseBoolToVisibility}}">
            <TextBlock Text="Connections" Style="{StaticResource FieldLabel}" Margin="0,16,0,6" />
            <StackPanel Orientation="Horizontal">
                <ui:NumberBox Value="{Binding Connections, UpdateSourceTrigger=PropertyChanged}" Minimum="1" Maximum="32"
                              SmallChange="1" LargeChange="4" MaxDecimalPlaces="0" Width="132"
                              ClearButtonEnabled="False" AutomationProperties.Name="Connections" />
                <TextBlock Text="Parts downloaded at the same time, 1 to 32" Style="{StaticResource CaptionText}"
                           Margin="12,0,0,0" />
            </StackPanel>
            </StackPanel>
        </StackPanel>

        <!-- Footer band, as in Windows 11 dialogs. -->
        <Border Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="24">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Appearance="Primary" Content="Start download" Command="{Binding StartNowCommand}"
                           IsDefault="True" MinWidth="128" />
                <ui:Button Content="Add to queue" Command="{Binding AddToQueueCommand}" Margin="8,0,0,0" MinWidth="112" />
                <ui:Button Content="Cancel" Command="{Binding CancelCommand}" IsCancel="True" Margin="8,0,0,0"
                           MinWidth="88" />
            </StackPanel>
        </Border>
    </StackPanel>
</ui:FluentWindow>
