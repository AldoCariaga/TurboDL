<ui:FluentWindow x:Class="TurboDL.App.Views.AddDownloadWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:TurboDL.App.ViewModels"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance vm:AddDownloadViewModel}"
                 Title="Add download"
                 Width="580" SizeToContent="Height" ResizeMode="NoResize"
                 ShowInTaskbar="False"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 FontFamily="{StaticResource TextFont}">

    <StackPanel>
        <ui:TitleBar Title="Add download" ShowMinimize="False" ShowMaximize="False" />

        <StackPanel Margin="24,4,24,20">
            <TextBlock Text="Link" Style="{StaticResource FieldLabel}" />
            <ui:TextBox x:Name="UrlBox" Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="https://example.com/file.zip" ClearButtonEnabled="True"
                        AutomationProperties.Name="Link" />

            <!-- Fixed height so the form doesn't jump while the link is being checked. -->
            <DockPanel Height="32" Margin="0,4,0,8">
                <ui:ProgressRing DockPanel.Dock="Left" Width="14" Height="14" IsIndeterminate="True" Margin="0,0,8,0"
                                 Visibility="{Binding IsChecking, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock x:Name="NoteText" Text="{Binding Note}" Style="{StaticResource CaptionText}"
                           TextWrapping="Wrap" TextTrimming="None" VerticalAlignment="Top" Margin="0,2,0,0" />
            </DockPanel>

            <TextBlock Text="File name" Style="{StaticResource FieldLabel}" />
            <ui:TextBox Text="{Binding FileName, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="Taken from the server" AutomationProperties.Name="File name" />

            <TextBlock Text="Save to" Style="{StaticResource FieldLabel}" Margin="0,16,0,6" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBox Text="{Binding Folder, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Save to" />
                <ui:Button Grid.Column="1" Margin="8,0,0,0" Command="{Binding BrowseCommand}" Content="Browse"
                           VerticalAlignment="Stretch" />
            </Grid>

            <TextBlock Text="Connections" Style="{StaticResource FieldLabel}" Margin="0,16,0,6" />
            <StackPanel Orientation="Horizontal">
                <ui:NumberBox Value="{Binding Connections, UpdateSourceTrigger=PropertyChanged}" Minimum="1" Maximum="32"
                              SmallChange="1" LargeChange="4" MaxDecimalPlaces="0" Width="132"
                              ClearButtonEnabled="False" AutomationProperties.Name="Connections" />
                <TextBlock Text="Parts downloaded at the same time, 1 to 32" Style="{StaticResource CaptionText}"
                           Margin="12,0,0,0" />
            </StackPanel>
        </StackPanel>

        <!-- Footer band, as in Windows 11 dialogs. -->
        <Border Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="24">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Appearance="Primary" Content="Start download" Command="{Binding StartNowCommand}"
                           IsDefault="True" MinWidth="128" />
                <ui:Button Content="Add to queue" Command="{Binding AddToQueueCommand}" Margin="8,0,0,0" MinWidth="112" />
                <ui:Button Content="Cancel" Command="{Binding CancelCommand}" IsCancel="True" Margin="8,0,0,0"
                           MinWidth="88" />
            </StackPanel>
        </Border>
    </StackPanel>
</ui:FluentWindow>
