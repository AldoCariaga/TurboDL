<ui:FluentWindow x:Class="TurboDL.App.Views.LinkPromptWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Download this link?"
                 Width="380" SizeToContent="Height" ResizeMode="NoResize" MinWidth="0" MinHeight="0"
                 ShowInTaskbar="False" Topmost="True" ShowActivated="False"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 FontFamily="{StaticResource TextFont}">
    <!-- No title bar: this is a notification, not a window to manage. Esc or Dismiss closes it. -->
    <Border Padding="16,14,16,16" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image x:Name="FileIcon" Width="32" Height="32" VerticalAlignment="Top" Margin="0,2,12,0"
                   RenderOptions.BitmapScalingMode="HighQuality" />
            <StackPanel Grid.Column="1">
                <TextBlock Text="Download the copied link?" Style="{StaticResource CaptionText}" />
                <TextBlock x:Name="FileName" Style="{StaticResource BodyText}" FontWeight="SemiBold" Margin="0,2,0,0" />
                <TextBlock x:Name="Host" Style="{StaticResource CaptionText}" Margin="0,2,0,0" />
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <ui:Button x:Name="DownloadButton" Appearance="Primary" Content="Download" MinWidth="104" Click="OnDownload" />
                    <ui:Button Content="Dismiss" Margin="8,0,0,0" MinWidth="88" Click="OnDismiss" IsCancel="True" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</ui:FluentWindow>
