<ui:FluentWindow x:Class="TurboDL.Setup.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="TurboDL Setup"
                 Width="640" Height="480"
                 ResizeMode="NoResize"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 Icon="pack://application:,,,/Assets/TurboDL.ico"
                 FontFamily="{StaticResource TextFont}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="TitleBar" Grid.Row="0" Title="TurboDL Setup" ShowMaximize="False">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/TurboDL.ico" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Grid Grid.Row="1" Margin="40,12,40,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Image Grid.Column="0" Source="pack://application:,,,/Assets/TurboDL.ico" Width="56" Height="56"
                   VerticalAlignment="Top" Margin="0,4,24,0" RenderOptions.BitmapScalingMode="HighQuality" />

            <!-- Install: Welcome -->
            <StackPanel x:Name="WelcomePage" Grid.Column="1">
                <TextBlock x:Name="WelcomeTitle" Style="{StaticResource PageTitle}" Text="Install TurboDL" />
                <TextBlock Style="{StaticResource SecondaryText}"
                           Text="A fast download manager for Windows. It splits downloads into parts, catches downloads from Chrome and Edge, and saves videos." />
                <ui:InfoBar x:Name="UpgradeNote" Margin="0,16,0,0" IsOpen="False" IsClosable="False" Severity="Informational"
                            Title="Already installed" />
                <TextBlock Style="{StaticResource BodyText}" Text="Install folder" Margin="0,20,0,6" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBox x:Name="FolderBox" Grid.Column="0" AutomationProperties.Name="Install folder" />
                    <ui:Button Grid.Column="1" Content="Change…" Margin="8,0,0,0" Click="OnChangeFolder" />
                </Grid>
                <TextBlock x:Name="AdminNote" Style="{StaticResource CaptionText}" Margin="0,8,0,0"
                           Text="Installing needs administrator rights: Windows asks when you click Install." />
            </StackPanel>

            <!-- Install: Options -->
            <StackPanel x:Name="OptionsPage" Grid.Column="1" Visibility="Collapsed">
                <TextBlock Style="{StaticResource PageTitle}" Text="Options" />
                <CheckBox x:Name="StartMenuBox" Style="{StaticResource Option}" Content="Start-menu shortcut" />
                <CheckBox x:Name="DesktopBox" Style="{StaticResource Option}" Content="Desktop shortcut" />
                <CheckBox x:Name="StartupBox" Style="{StaticResource Option}" Content="Start TurboDL with Windows" />
                <TextBlock Style="{StaticResource CaptionText}" Margin="0,10,0,0"
                           Text="TurboDL is also registered with Chrome and Edge, so the TurboDL extension can hand it downloads." />
            </StackPanel>

            <!-- Uninstall: Confirm -->
            <StackPanel x:Name="ConfirmPage" Grid.Column="1" Visibility="Collapsed">
                <TextBlock Style="{StaticResource PageTitle}" Text="Uninstall TurboDL?" />
                <TextBlock x:Name="ConfirmText" Style="{StaticResource SecondaryText}"
                           Text="This removes TurboDL from this PC: the app, its Chrome and Edge registration, its shortcuts and the video tools it downloaded. Files you downloaded stay where they are." />
                <CheckBox x:Name="RemoveDataBox" Style="{StaticResource Option}" Margin="0,20,0,0"
                          Content="Also remove my downloads list and settings" />
            </StackPanel>

            <!-- Progress (both) -->
            <StackPanel x:Name="ProgressPage" Grid.Column="1" Visibility="Collapsed">
                <TextBlock x:Name="ProgressTitle" Style="{StaticResource PageTitle}" Text="Installing TurboDL" />
                <TextBlock x:Name="StepText" Style="{StaticResource SecondaryText}" Text="Getting ready" Margin="0,0,0,12" />
                <ProgressBar x:Name="Bar" Height="4" Minimum="0" Maximum="1" IsIndeterminate="True" />
            </StackPanel>

            <!-- Done (both) -->
            <StackPanel x:Name="DonePage" Grid.Column="1" Visibility="Collapsed">
                <TextBlock x:Name="DoneTitle" Style="{StaticResource PageTitle}" Text="TurboDL is installed" />
                <TextBlock x:Name="DoneText" Style="{StaticResource SecondaryText}"
                           Text="To catch downloads in Chrome or Edge, add the TurboDL extension to the browser." />
                <CheckBox x:Name="LaunchBox" Style="{StaticResource Option}" Margin="0,20,0,0" Content="Launch TurboDL" IsChecked="True" />
            </StackPanel>

            <!-- Something went wrong (both) -->
            <StackPanel x:Name="ErrorPage" Grid.Column="1" Visibility="Collapsed">
                <TextBlock x:Name="ErrorTitle" Style="{StaticResource PageTitle}" Text="Setup couldn't finish" />
                <TextBlock x:Name="ErrorText" Style="{StaticResource SecondaryText}" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Padding="24,14" Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <TextBlock x:Name="VersionText" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ui:Button x:Name="BackButton" Content="Back" MinWidth="96" Margin="0,0,8,0" Click="OnBack" />
                    <ui:Button x:Name="NextButton" Content="Next" MinWidth="96" Margin="0,0,8,0" Appearance="Primary" Click="OnNext" IsDefault="True" />
                    <ui:Button x:Name="CancelButton" Content="Cancel" MinWidth="96" Click="OnCancel" IsCancel="True" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
