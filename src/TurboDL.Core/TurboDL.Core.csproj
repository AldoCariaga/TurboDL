<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <!-- Built-in site configs: resources, so the single-file app has them too (SiteConfigLoader reads them by this name). -->
    <EmbeddedResource Include="Sites\BuiltIn\*.json" LogicalName="TurboDL.Core.Sites.BuiltIn.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TurboDL.Ipc\TurboDL.Ipc.csproj" />
  </ItemGroup>

</Project>
