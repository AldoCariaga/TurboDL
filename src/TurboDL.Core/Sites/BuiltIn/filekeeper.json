{
  // FileKeeper (taken from a live page, 2026-11-08). The link's page moves on to /download by itself; a countdown runs
  // (about 5 s), and only then is the "Free download" button (#download-button) put on the page. Clicking it posts a
  // form to /download in the same tab, which starts the file as a browser download. No CAPTCHA was shown, but the page
  // can ask for one (data-has-captcha), so the captcha step waits for the user when there is one.
  // The click sometimes sends the tab to an ad instead: offSiteRedirects brings it back and the steps start again.
  // Or an ad script takes it and only opens a pop-up, so the form is never posted: retryIfIgnoredSeconds clicks again
  // when the page sends nothing within 4 s, instead of sitting out the 20 s wait for a file that isn't coming.
  "id": "filekeeper",
  "name": "FileKeeper",
  "hosts": ["filekeeper.net"],
  "browserFirst": true,
  "steps": [
    { "action": "waitFor", "selector": "#download-button", "state": "visible", "timeoutSeconds": 120 },
    { "action": "captcha", "timeoutSeconds": 300 },
    { "action": "click", "selector": "#download-button", "timeoutSeconds": 30, "retryIfIgnoredSeconds": 4 },
    // Time for the download to start before anything else touches the page (the general autopilot would click again).
    // A trip to an ad cuts it short.
    { "action": "wait", "seconds": 20 }
  ],
  // Every real part so far came from edge01.fetchio.cc; a download from anywhere else (an ad) is ignored.
  "capture": { "urlPattern": null, "requireAttachment": true, "fileHosts": ["fetchio.cc"] },
  "popups": "closeAds",
  "offSiteRedirects": "goBack",
  "whenStepsEnd": "generic"
}
